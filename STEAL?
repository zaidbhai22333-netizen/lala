-- ── 4. ANTI-LOG / FINGERPRINT CLOAK ──────────
-- blank out executor tells that anti-cheat scripts scan for
local function install_anti_log()
    if not CFG.AntiLog then return end
    pcall(function()
        -- cloak syn.request / http_request executor globals
        if syn then syn.request = function() return {StatusCode=200,Body=""} end end
        if http_request then http_request = function() return {StatusCode=200,Body=""} end end
        -- suppress print/warn so AC logging scripts get no output
        local _print=print; local _warn=warn
        print=newcclosure(function(...)
            local s=tostring(select(1,...) or "")
            if s:lower():find("cheat") or s:lower():find("exploit") or
               s:lower():find("hack")  or s:lower():find("inject") then return end
            _print(...)
        end)
        warn=newcclosure(function(...)
            local s=tostring(select(1,...) or "")
            if s:lower():find("cheat") or s:lower():find("exploit") then return end
            _warn(...)
        end)
    end)
end
