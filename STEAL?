-- ESP — PLAYERS + TRACERS
-- ════════════════════════════════════════════
local player_esp = {}
local tracer_lines = {}

local function clear_player_esp()
    for _, v in pairs(player_esp)   do pcall(function() v:Destroy() end) end
    for _, v in pairs(tracer_lines) do pcall(function() v:Destroy() end) end
    player_esp   = {}
    tracer_lines = {}
end

RunService.RenderStepped:Connect(function()
    if not CFG.PlayerESP and not CFG.ShowTracers then
        clear_player_esp(); return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local phrp = p.Character:FindFirstChild("HumanoidRootPart")
            if phrp then
                -- box
                if CFG.PlayerESP then
                    if not player_esp[p] then
                        local b = Instance.new("SelectionBox")
                        b.Color3              = CFG.PlayerESPColor
                        b.LineThickness       = 1.5
                        b.SurfaceTransparency = 0.7
                        b.SurfaceColor3       = CFG.PlayerESPColor
                        b.Adornee             = phrp
                        b.Parent              = workspace
                        player_esp[p]         = b
                    end
                else
                    if player_esp[p] then player_esp[p]:Destroy(); player_esp[p]=nil end
                end
                -- tracer
                if CFG.ShowTracers then
                    if not tracer_lines[p] then
                        local line = Drawing.new("Line")
                        line.Thickness = 1
                        line.Color     = CFG.TracerColor
                        line.Visible   = true
                        tracer_lines[p] = line
                    end
                    local sp, vis = cam:WorldToViewportPoint(phrp.Position)
                    if vis then
                        tracer_lines[p].From = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
                        tracer_lines[p].To   = Vector2.new(sp.X, sp.Y)
                    end
                else
                    if tracer_lines[p] then tracer_lines[p]:Remove(); tracer_lines[p]=nil end
                end
            end
        end
    end
end)

-- ════════════════════════════════════════════
-- CROSSHAIR
-- ════════════════════════════════════════════
local ch_lines = {}
local function make_crosshair()
    for _, l in ipairs(ch_lines) do l:Remove() end
    ch_lines = {}
    if not CFG.Crosshair then return end
    local cx = cam.ViewportSize.X/2
    local cy = cam.ViewportSize.Y/2
    local sz = 10
    local colors = {
        {Vector2.new(cx-sz,cy), Vector2.new(cx-3,cy)},
        {Vector2.new(cx+3,cy),  Vector2.new(cx+sz,cy)},
        {Vector2.new(cx,cy-sz), Vector2.new(cx,cy-3)},
        {Vector2.new(cx,cy+3),  Vector2.new(cx,cy+sz)},
    }
    for _, c in ipairs(colors) do
        local l = Drawing.new("Line")
        l.From = c[1]; l.To = c[2]
        l.Color = Color3.new(1,1,1)
        l.Thickness = 1.5
        l.Visible = true
        table.insert(ch_lines, l)
    end
end

RunService.RenderStepped:Connect(function()
    if not CFG.Crosshair then
        for _, l in ipairs(ch_lines) do l.Visible = false end
    else
        for _, l in ipairs(ch_lines) do l.Visible = true end
    end
end)

