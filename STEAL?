                end
            end
        end
    end
end)

local ch_lines={}
local function make_crosshair()
    for _,l in ipairs(ch_lines) do pcall(function()l:Remove()end) end
    ch_lines={}
    if not CFG.Crosshair then return end
    local cx=cam.ViewportSize.X/2;local cy=cam.ViewportSize.Y/2;local sz=10
    for _,s in ipairs({
        {Vector2.new(cx-sz,cy),Vector2.new(cx-3,cy)},
        {Vector2.new(cx+3,cy),Vector2.new(cx+sz,cy)},
        {Vector2.new(cx,cy-sz),Vector2.new(cx,cy-3)},
        {Vector2.new(cx,cy+3),Vector2.new(cx,cy+sz)}
    }) do
        local l=Drawing.new("Line")
        l.From=s[1];l.To=s[2];l.Color=Color3.new(1,1,1)
        l.Thickness=1.5;l.Visible=true;table.insert(ch_lines,l)
    end
end

