local log_layout=Instance.new("UIListLayout",log_scroll)
log_layout.Padding=UDim.new(0,2);log_layout.SortOrder=Enum.SortOrder.LayoutOrder

-- refresh log every 0.5s
task.spawn(function()
    while true do
        task.wait(0.5)
        if active_tab=="Bypass" then
            for _,c in ipairs(log_scroll:GetChildren()) do
                if c:IsA("TextLabel") then c:Destroy() end
            end
            for i,entry in ipairs(CFG.DetectedEvents) do
                if i>30 then break end
                local l=Instance.new("TextLabel",log_scroll)
                l.Text=entry;l.Size=UDim2.new(1,-8,0,16)
                l.BackgroundTransparency=1
                l.TextColor3=entry:find("⚠") and T.Warn
                    or entry:find("🔴") and Color3.fromRGB(255,80,80)
                    or T.Sub
                l.Font=Enum.Font.Gotham;l.TextSize=10
                l.TextXAlignment=Enum.TextXAlignment.Left
                l.TextTruncate=Enum.TextTruncate.AtEnd
            end
            log_scroll.CanvasSize=UDim2.new(0,0,0,log_layout.AbsoluteContentSize.Y+4)
        end
    end
end)

