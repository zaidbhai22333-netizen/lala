local function notif(title, body, dur)
    if not CFG.NotifEnabled then return end
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = title or "STEAL",
            Text     = body  or "",
            Duration = dur   or 3,
        })
    end)
end

local function get_eggs()
    local t = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("BasePart") or v:IsA("MeshPart")) and
           v.Name:lower():find(CFG.EggKeyword:lower()) then
            table.insert(t, v)
        end
    end
    return t
end

local function nearest_egg()
    local best, bd = nil, math.huge
    for _, e in ipairs(get_eggs()) do
        local d = (hrp.Position - e.Position).Magnitude
        if d < bd then bd = d; best = e end
    end
    return best, bd
end

local function tp(pos)
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
end

local function tween_tp(pos, spd)
    local d = (hrp.Position - pos).Magnitude
    local ti = TweenInfo.new(math.max(d / (spd or 60), 0.05), Enum.EasingStyle.Linear)
    TweenService:Create(hrp, ti, {CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))}):Play()
end

local function fire_touch(part)
    pcall(firetouchinterest, hrp, part, 0)
    task.wait(0.03)
    pcall(firetouchinterest, hrp, part, 1)
end

