local TABS = {"Farm","Player","Visual","Teleport","Misc","Settings"}
local tab_btns  = {}
local tab_pages = {}
local active_tab = "Farm"

local function show_tab(name)
    active_tab = name
    for _, t in ipairs(TABS) do
        if tab_pages[t] then
            for _, w in ipairs(tab_pages[t]) do
                if w and w.Parent then w.Visible = (t == name) end
            end
        end
        if tab_btns[t] then
            tab_btns[t].BackgroundColor3 = (t == name) and T.TabSel or T.Tab
            tab_btns[t].TextColor3       = (t == name) and T.Text  or T.Sub
        end
    end
end

for _, name in ipairs(TABS) do
    tab_pages[name] = {}
    local tb = Instance.new("TextButton")
    tb.Text             = name
    tb.Size             = UDim2.new(0, 80, 1, 0)
    tb.BackgroundColor3 = T.Tab
    tb.TextColor3       = T.Sub
    tb.Font             = Enum.Font.GothamBold
    tb.TextSize         = 11
    tb.BorderSizePixel  = 0
    tb.Parent           = tabbar
    tab_btns[name]      = tb
    tb.MouseButton1Click:Connect(function() show_tab(name) end)
end

-- helper: register widget to tab
local function reg(tab_name, widget)
    if widget then
        table.insert(tab_pages[tab_name], widget)
        widget.Visible = (tab_name == active_tab)
    end
end

