-- FLY
-- ════════════════════════════════════════════
local fly_conn
local fly_bp, fly_bg

local function start_fly()
    if fly_bp then fly_bp:Destroy() end
    if fly_bg then fly_bg:Destroy() end
    fly_bp = Instance.new("BodyPosition")
    fly_bp.MaxForce = Vector3.new(1e6,1e6,1e6)
    fly_bp.D = 100; fly_bp.P = 1e4
    fly_bp.Parent = hrp
    fly_bg = Instance.new("BodyGyro")
    fly_bg.MaxTorque = Vector3.new(1e6,1e6,1e6)
    fly_bg.D = 100; fly_bg.P = 1e4
    fly_bg.Parent = hrp
    fly_conn = RunService.Heartbeat:Connect(function()
        if not CFG.FlyEnabled then
            if fly_bp then fly_bp:Destroy() end
            if fly_bg then fly_bg:Destroy() end
            fly_conn:Disconnect()
            return
        end
        local spd = CFG.FlySpeed
        local mv = Vector3.new()
        local cf = cam.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)  then mv = mv + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv = mv - Vector3.new(0,1,0) end
        fly_bp.Position = hrp.Position + mv * spd * 0.1
        fly_bg.CFrame   = cam.CFrame
    end)
end

