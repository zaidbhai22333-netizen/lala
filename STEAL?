-- ── 5. REMOTE SPY + BLOCKER ──────────────────
-- passively log all outgoing FireServer calls
-- and optionally block named remotes
local remote_log = {}

local function install_remote_spy()
    pcall(function()
        local oldFS2 = RemoteEvent.FireServer
        hookfunction(oldFS2, newcclosure(function(self, ...)
            local name = self.Name
            local entry = {
                name = name,
                time = os.clock(),
                args = {...}
            }
            table.insert(remote_log, 1, entry)
            if #remote_log > 80 then table.remove(remote_log) end
            table.insert(CFG.DetectedEvents, 1, ("[%.2f] RE:FireServer → %s"):format(os.clock(), name))
            if #CFG.DetectedEvents > 60 then table.remove(CFG.DetectedEvents) end

            -- block if in blocklist
            if CFG.RemoteBlock then
                for _,blocked in ipairs(CFG.BlockedRemotes) do
                    if name:lower():find(blocked:lower()) then return end
                end
            end

            -- flag suspicious AC-named remotes
            local ac_keywords = {
                "kick","ban","detect","cheat","exploit","hack",
                "anticheat","ac_","_ac","verify","validate","check",
                "speed","position","sanity","report","flag","monitor"
            }
            for _,kw in ipairs(ac_keywords) do
                if name:lower():find(kw) then
                    table.insert(CFG.DetectedEvents,1,
                        ("⚠ SUSPICIOUS: %s"):format(name))
                    break
                end
            end

            return oldFS2(self, ...)
        end))
    end)
end

local function install_invoke_spy()
    pcall(function()
        local oldInvoke = RemoteFunction.InvokeServer
        hookfunction(oldInvoke, newcclosure(function(self, ...)
            local name = self.Name
            table.insert(CFG.DetectedEvents, 1,
                ("[%.2f] RF:InvokeServer → %s"):format(os.clock(), name))
            if #CFG.DetectedEvents > 60 then table.remove(CFG.DetectedEvents) end
            return oldInvoke(self, ...)
        end))
    end)
end

