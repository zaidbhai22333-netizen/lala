-- FARM LOOP
-- ════════════════════════════════════════════
local farm_active = false
task.spawn(function()
    while true do
        task.wait(CFG.FarmDelay)
        if (CFG.AutoFarm or CFG.AutoCollect) and hrp then
            local egg, dist = nearest_egg()
            if egg then
                if CFG.AutoFarm then
                    if dist > CFG.CollectRadius then
                        if CFG.LoopTeleport then
                            tp(egg.Position)
                        else
                            tween_tp(egg.Position, CFG.TeleportSpeed or 80)
                        end
                    else
                        fire_touch(egg)
                    end
                end
                if CFG.AutoCollect then
                    fire_touch(egg)
                end
            end
        end
    end
end)

