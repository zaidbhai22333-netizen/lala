                    end
                    local sp,vis=cam:WorldToViewportPoint(ph.Position)
                    if vis then
                        p_tracers[p].From=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y)
                        p_tracers[p].To=Vector2.new(sp.X,sp.Y)
                    end
