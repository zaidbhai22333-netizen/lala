-- ── 1. FAKE WALKSPEED ────────────────────────
-- replicate WalkSpeed at safe value to server-side checks
-- while we apply the real value client-side each heartbeat
local SAFE_SPEED = 16
local real_speed_mt = {}

local function apply_fake_walkspeed()
    if not CFG.FakeWalkspeed or not hum then return end
    -- some games read .WalkSpeed via RemoteEvent health-checks;
    -- we shadow the value with a metatable on the humanoid's property table
    -- where supported by the executor
    pcall(function()
        local mt = getrawmetatable(hum)
        if mt and mt.__newindex then
            local old_ni = mt.__newindex
            setreadonly(mt, false)
            mt.__newindex = newcclosure(function(self, key, value)
                if key == "WalkSpeed" and CFG.FakeWalkspeed then
                    -- let client see real value, report safe value
                    rawset(self, key, value)
                    return
                end
                old_ni(self, key, value)
            end)
            setreadonly(mt, true)
        end
    end)
end
task.spawn(apply_fake_walkspeed)

-- ── 2. TELEPORT SANITIZER BYPASS ─────────────
-- many egg games fire a RemoteEvent after each collect to validate
-- server-side position. we hook FireServer to clamp the reported
-- position to a plausible movement delta before it leaves the client.
local LAST_SAFE_POS = Vector3.new(0,0,0)
local TP_MAX_DELTA  = 20  -- studs per frame considered "safe" by most validators

local function install_tp_bypass()
    if not CFG.TeleportBypass then return end
    pcall(function()
        local oldFS = RemoteEvent.FireServer
        hookfunction(oldFS, newcclosure(function(self, ...)
            local args = {...}
            -- if first arg is a CFrame or Vector3, sanitize it
            for i,v in ipairs(args) do
                if typeof(v)=="CFrame" then
                    local pos=v.Position
                    local delta=(pos-LAST_SAFE_POS).Magnitude
                    if delta > TP_MAX_DELTA then
                        -- lerp reported position toward real; real movement happens client-side
                        args[i]=CFrame.new(LAST_SAFE_POS:Lerp(pos, TP_MAX_DELTA/delta))
                    else
                        LAST_SAFE_POS=pos
                    end
                elseif typeof(v)=="Vector3" then
                    local delta=(v-LAST_SAFE_POS).Magnitude
                    if delta > TP_MAX_DELTA then
                        args[i]=LAST_SAFE_POS:Lerp(v, TP_MAX_DELTA/delta)
                    else
                        LAST_SAFE_POS=v
                    end
                end
            end
            return oldFS(self, table.unpack(args))
        end))
    end)
end
task.spawn(install_tp_bypass)

