local esp_boxes = {}

local function clear_egg_esp()
    for _, b in ipairs(esp_boxes) do pcall(function() b:Destroy() end) end
    esp_boxes = {}
end

RunService.Heartbeat:Connect(function()
    if not CFG.ESP then clear_egg_esp(); return end
    local eggs = get_eggs()
    -- remove stale
    for i = #esp_boxes, 1, -1 do
        if not esp_boxes[i] or not esp_boxes[i].Parent then
            table.remove(esp_boxes, i)
        end
    end
    -- add new
    if #esp_boxes ~= #eggs then
        clear_egg_esp()
        for _, e in ipairs(eggs) do
            local b = Instance.new("SelectionBox")
            b.Color3               = CFG.ESPColor
            b.LineThickness        = CFG.ESPThickness
            b.SurfaceTransparency  = 0.65
            b.SurfaceColor3        = CFG.ESPColor
            b.Adornee              = e
            b.Parent               = workspace
            table.insert(esp_boxes, b)
        end
    end
end)

