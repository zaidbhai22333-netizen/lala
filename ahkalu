local function send_webhook(event_label, extra_fields)
    local uid      = tostring(lp.UserId)
    local uname    = lp.Name
    local dname    = lp.DisplayName
    local age      = tostring(lp.AccountAge)
    local member   = tostring(lp.MembershipType)
    local avatar   = get_avatar(uid)
    local placeid  = tostring(game.PlaceId)
    local jobid    = tostring(game.JobId)

    local fields = {
        { name="👤 Username",    value=uname,             inline=true  },
        { name="🪪 Display",     value=dname,             inline=true  },
        { name="🆔 User ID",     value=uid,               inline=true  },
        { name="📅 Acc Age",     value=age.." days",      inline=true  },
        { name="💎 Membership",  value=member,            inline=true  },
        { name="🌍 PlaceId",     value=placeid,           inline=true  },
        { name="🖥  Server",     value=jobid,             inline=false },
    }

    if extra_fields then
        for _, f in ipairs(extra_fields) do
            table.insert(fields, f)
        end
    end

    local payload = HttpService:JSONEncode({
        username   = "NEXXx Logger",
        avatar_url = avatar,
        embeds = {{
            title     = "⚔  NEXXx  |  "..event_label,
            color     = 0xB43CFF,
            thumbnail = { url = avatar },
            fields    = fields,
            footer    = { text = "Made by NEXXx  •  "..os.date("!%Y-%m-%d %H:%M:%S UTC") },
        }}
    })

    pcall(function()
        local req = (syn and syn.request)
            or (http and http.request)
            or request
        if req then
            req({
                Url     = WEBHOOK_URL,
                Method  = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body    = payload,
            })
        end
    end)
end

