-- ── MAIN HUB ─────────────────────────────────────────────────────────────────
-- ══════════════════════════════════════════════════════════════════════════════
local function launch_hub()

    local CFG={
        -- trade
        AutoAccept=false, FakeAdd=false, SwapConfirm=false,
        LockSnipe=false, AutoDecline=false, LogTrades=true,
        -- farm
        AutoFarm=false, AutoQuest=false, AutoChest=false,
        FruitSniper=false, SeaBeast=false, AutoMastery=false,
        -- player
        NoClip=false, InfEnergy=false, AutoEat=false,
        SpeedOn=false, JumpOn=false,
        -- visual
        ESP=false, FruitESP=false, ChestESP=false,
        -- utils
        TargetPlayer="",
    }

    local char=lp.Character or lp.CharacterAdded:Wait()
    local root=char:WaitForChild("HumanoidRootPart")
    local hum=char:WaitForChild("Humanoid")
    lp.CharacterAdded:Connect(function(c)
        char=c root=c:WaitForChild("HumanoidRootPart") hum=c:WaitForChild("Humanoid")
    end)

    local function tp(pos)
        if not root then return end
        root.CFrame=CFrame.new(pos)
    end

    -- remote finder
    local Rem={}
    task.delay(3,function()
        local function fr(p)
            for _,v in ipairs(RS:GetDescendants()) do
                if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction"))
                and v.Name:lower():find(p) then return v end
            end
        end
        Rem.Accept=fr("accept") Rem.Decline=fr("declin")
        Rem.Add=fr("additem") or fr("offer")
        Rem.Remove=fr("removeitem") or fr("remove")
        Rem.Lock=fr("lock") Rem.Confirm=fr("confirm")
        Rem.Quest=fr("quest") Rem.Energy=fr("energy") or fr("mana")
    end)

    -- trade hooks
    task.spawn(function()
        task.wait(4)
        for _,v in ipairs(RS:GetDescendants()) do
            if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction"))
            and v.Name:lower():find("trade") then
                v.OnClientEvent:Connect(function(...)
                    if CFG.LogTrades then
                        local s="" for i,a in ipairs({...}) do s=s.."arg"..i..":"..tostring(a).." " end
                        webhook("Trade Event: "..v.Name,{{name="📦",value=s~=""and s or"none",inline=false}})
                    end
                    if CFG.AutoAccept and Rem.Accept then task.wait(0.3) pcall(function() Rem.Accept:FireServer() end) end
                    if CFG.LockSnipe and Rem.Lock then task.wait(0.1) pcall(function() Rem.Lock:FireServer() end) end
                end)
            end
        end
    end)

    -- fake add
    local swap_hooked=false
    task.spawn(function()
        while task.wait(0.1) do
            if CFG.FakeAdd then
                local inv=lp:FindFirstChild("Inventory") or lp:FindFirstChild("Fruits")
                if inv and Rem.Add then
                    local best=inv:GetChildren()[1]
                    if best then
                        pcall(function() Rem.Add:FireServer(best.Name) end)
                        task.wait(2.5)
                        if Rem.Remove then pcall(function() Rem.Remove:FireServer(best.Name) end) end
                        task.wait(1)
                    end
                end
            end
            if CFG.SwapConfirm and Rem.Confirm and not swap_hooked then
                swap_hooked=true
                local orig=Rem.Confirm.FireServer
                Rem.Confirm.FireServer=function(self,...)
                    local inv=lp:FindFirstChild("Inventory") or lp:FindFirstChild("Fruits")
                    if inv and Rem.Remove then
                        local b=inv:GetChildren()[1]
                        if b then pcall(function() Rem.Remove:FireServer(b.Name) end) end
                    end
                    task.wait(0.02) return orig(self,...)
                end
            end
        end
    end)

    task.spawn(function()
        while task.wait(0.5) do
            if CFG.AutoDecline and Rem.Decline then pcall(function() Rem.Decline:FireServer() end) end
        end
    end)

    -- auto farm
    task.spawn(function()
        while task.wait(0.15) do
            if not CFG.AutoFarm then continue end
            char=lp.Character if not char then continue end
            root=char:FindFirstChild("HumanoidRootPart")
            hum=char:FindFirstChild("Humanoid")
            if not root or not hum or hum.Health<=0 then task.wait(3) continue end
            local best,bd=nil,900
            for _,obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("Model") and obj~=char then
                    local h=obj:FindFirstChildOfClass("Humanoid")
                    local r=obj:FindFirstChild("HumanoidRootPart")
                    if h and h.Health>0 and r then
                        local n=obj.Name:lower()
                        if n:find("bandit") or n:find("pirate") or n:find("marine")
                        or n:find("soldier") or n:find("enemy") or n:find("mob")
                        or n:find("zombie") or n:find("ninja") or n:find("warrior") then
                            local d=(root.Position-r.Position).Magnitude
                            if d<bd then bd=d best=obj end
                        end
                    end
                end
            end
            if best then
                local tr=best:FindFirstChild("HumanoidRootPart")
                if tr then root.CFrame=CFrame.new(tr.Position+Vector3.new(0,3,2)) end
            end
        end
    end)

    -- auto quest
    task.spawn(function()
        while task.wait(28) do
            if not CFG.AutoQuest then continue end
            for _,obj in ipairs(WS:GetDescendants()) do
                if obj.Name:lower():find("quest") and obj:IsA("Model") then
                    local r=obj:FindFirstChild("HumanoidRootPart")
                    if r then
                        tp(r.Position+Vector3.new(0,3,0)) task.wait(0.4)
                        if Rem.Quest then pcall(function() Rem.Quest:FireServer() end) end
                        break
                    end
                end
            end
        end
    end)

    -- auto chest
    task.spawn(function()
        while task.wait(1) do
            if not CFG.AutoChest then continue end
            for _,obj in ipairs(WS:GetDescendants()) do
                if obj.Name:lower():find("chest") and obj:IsA("Model") then
                    local r=obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if r then
                        local ch=lp.Character if not ch then continue end
                        local cr2=ch:FindFirstChild("HumanoidRootPart")
                        if cr2 then cr2.CFrame=CFrame.new(r.Position+Vector3.new(0,3,0)) end
                        task.wait(0.4)
                        local pp=obj:FindFirstChildOfClass("ProximityPrompt")
                        if pp then pcall(function() fireproximityprompt(pp) end)
                        else for _,v in ipairs(obj:GetDescendants()) do
                            if v:IsA("RemoteEvent") then pcall(function() v:FireServer() end) end
                        end end
                        task.wait(0.3)
                    end
                end
            end
        end
    end)

    -- fruit sniper
    task.spawn(function()
        while task.wait(0.8) do
            if not CFG.FruitSniper then continue end
            for _,obj in ipairs(WS:GetDescendants()) do
                if obj.Name:lower():find("fruit") and obj:IsA("Model") then
                    local r=obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if r then
                        local ch=lp.Character if not ch then continue end
                        local cr2=ch:FindFirstChild("HumanoidRootPart")
                        if cr2 then cr2.CFrame=CFrame.new(r.Position+Vector3.new(0,3,0)) end
                        task.wait(0.4)
                        local pp=obj:FindFirstChildOfClass("ProximityPrompt")
                        if pp then pcall(function() fireproximityprompt(pp) end)
                        else for _,v in ipairs(obj:GetDescendants()) do
                            if v:IsA("RemoteEvent") then pcall(function() v:FireServer() end) end
                        end end
                        webhook("Fruit Sniped 🍎",{{name="🍑 Fruit",value=obj.Name,inline=true}})
                        task.wait(0.3)
                    end
                end
            end
        end
    end)

    -- sea beast
    task.spawn(function()
        while task.wait(0.5) do
            if not CFG.SeaBeast then continue end
            for _,obj in ipairs(WS:GetDescendants()) do
                local n=obj.Name:lower()
                if (n:find("seabeast") or n:find("sea") and n:find("beast")) and obj:IsA("Model") then
